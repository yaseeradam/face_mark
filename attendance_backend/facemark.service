[Unit]
Description=FaceMark FastAPI Backend Daemon
After=network.target

[Service]
User=root
WorkingDirectory=/var/www/face_mark/attendance_backend
ExecStart=/var/www/face_mark/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8100 --workers 1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
